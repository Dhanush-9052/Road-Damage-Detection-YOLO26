# RoadVision AI Backend Environment Configuration

# Path to the trained YOLO weights (defaults to backend/models/best.pt)
MODEL_PATH=models/best.pt

# Inference default thresholds
CONF_THRESHOLD_DEFAULT=0.20
IOU_THRESHOLD_DEFAULT=0.45
IMG_SIZE_DEFAULT=640

# Max Upload Sizes
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=250

# Database
DATABASE_PATH=roadvision.db
